# Copy to .env, chmod 600. Never commit populated values.
PUBLIC_HOST=agent.example.org
# Generate each independently: openssl rand -hex 32
N8N_ENCRYPTION_KEY=
INTERNAL_API_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Dedicated login granted agent_runtime. URL-encode password characters.
# Direct connection or Supavisor SESSION pooler, not transaction pooler.
# Use the dashboard connection host/port. Do not add sslmode URL parameters.
DATABASE_URL=postgresql://agent_login:REPLACE@YOUR_DB_HOST:5432/postgres
# Optional if Supabase requires a downloaded CA; mount ./secrets/db-ca.crt.
DATABASE_CA_FILE=
LOCAL_DATABASE_NO_TLS=false

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=

# Choose a currently eligible FREE model in AI Studio; no model fallback.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FREE_TIER_CONFIRMED=false

# DRY_RUN consumes approved drafts as 'simulated', NEVER as 'published'.
# Keep test drafts in a separate database. Disabling dry-run does not enable X.
DRY_RUN=true
PUBLISHING_ENABLED=false
X_COST_APPROVED=false
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
