{
  # Public ACME certificates do not require an account email.
  admin off
}
{$PUBLIC_HOST} {
  header {
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
  }
  request_body {
    max_size 64KB
  }
  @telegram {
    method POST
    path /webhook/telegram-approval
  }
  handle @telegram {
    reverse_proxy n8n:5678
  }
  # No editor, REST API, health route, test webhook, or agent API is public.
  handle {
    respond "Not found" 404
  }
}
