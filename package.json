{
  "name": "x-content-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test --test-concurrency=1",
    "workflows": "node scripts/build-workflows.js",
    "check": "node scripts/check.js",
    "verify": "npm run check && npm test",
    "telegram:webhook": "node --env-file=.env scripts/telegram-webhook.js"
  },
  "dependencies": {
    "fast-xml-parser": "5.12.0",
    "ipaddr.js": "2.5.0",
    "pg": "8.23.1",
    "twitter-text": "3.1.0",
    "undici": "8.12.4"
  },
  "devDependencies": { "@electric-sql/pglite": "0.5.15" }
}
